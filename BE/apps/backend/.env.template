# --- Database ---
# Local Postgres connection string. Create the database first, e.g.:
#   psql -U postgres -c "CREATE DATABASE altera_medusa_be;"
DATABASE_URL=postgres://postgres:<password>@localhost:5432/altera_medusa_be

# --- CORS ---
# STORE_CORS and AUTH_CORS already include localhost:8000 for the Day 2 Next.js storefront.
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000,https://docs.medusajs.com

# --- Secrets (fine for local; change for anything non-local) ---
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Encrypts stored MFA secrets. Generate your own random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_MFA_ENCRYPTION_KEY=<64-char-hex-string>

# Controls the admin dashboard's first-run onboarding checklist. "default" is fine.
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# --- Optional ---
# Set in .env by the scaffold, but medusa-config.ts never reads it into
# projectConfig — confirmed by the dev server logging "redisUrl not found.
# A fake redis instance will be used." even with this set. Harmless to leave
# unset; only wire it into medusa-config.ts if you actually run local Redis.
# REDIS_URL=redis://localhost:6379
